VTIGER_BASE_URL=https://vtiger.example.com
VTIGER_USERNAME=api-user
VTIGER_ACCESS_KEY=replace-with-vtiger-access-key
VTIGER_ALLOW_INSECURE_HTTP=false
VTIGER_TEST_MODULE=Contacts
# Enable after confirming the modern convertlead registration:
VTIGER_RUN_LEAD_TESTS=false
# Creates and deletes a small Document fixture on the configured test instance:
VTIGER_RUN_DOCUMENT_TESTS=false
# Optional Upload-and-Link fixture (the Document is deleted after the test):
VTIGER_RUN_DOCUMENT_LINK_TESTS=false
# VTIGER_TEST_DOCUMENT_LINK_RECORD_ID=12x345
# VTIGER_TEST_DOCUMENT_RELATION_LABEL=Documents
# Optional read-only retrieve test:
# VTIGER_TEST_RECORD_ID=12x345
# Optional read-only inventory retrieve test:
# VTIGER_TEST_INVENTORY_ID=7x999999
# Optional read-only attachment test (value from imageattachmentids):
# VTIGER_TEST_ATTACHMENT_ID=15x456
